{
  "name": "slothfile",
  "version": "0.1.0",
  "description": "Local-first, AI-assisted desktop file organizer. AI proposes, you approve every move.",
  "private": true,
  "license": "MIT",
  "author": "SlothFile contributors",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:ollama": " cross-env SLOTHFILE_OLLAMA_SMOKE=1 vitest run tests/integration/ollama-smoke.test.ts",
    "rebuild:electron": "electron-builder install-app-deps",
    "rebuild:node": "pnpm rebuild better-sqlite3",
    "dist": "pnpm rebuild:electron && electron-vite build && electron-builder --win --x64",
    "dist:dir": "pnpm rebuild:electron && electron-vite build && electron-builder --dir",
    "check:env": "node --experimental-strip-types scripts/check-environment.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.61.0",
    "oxlint": "^1.89.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "pdfjs-dist": "5.7.284",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "productName": "SlothFile"
}
