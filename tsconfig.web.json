{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "@testing-library/jest-dom/vitest"
    ],
    "paths": {
      "@shared/*": [
        "./src/shared/*"
      ],
      "@renderer/*": [
        "./src/renderer/*"
      ]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/preload/**/*.d.ts",
    "src/shared/**/*",
    "tests/unit/renderer/**/*",
    "tests/helpers/setup.ts"
  ]
}